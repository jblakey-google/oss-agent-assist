{
  "orgName": "Google",
  "edition": "Developer",
  "features": [
    "EnableSetPasswordInApi",
    "ServiceCloud",
    "LiveAgent",
    "LiveMessage",
    "ServiceCloudVoicePartnerTelephony",
    "LightningServiceConsole",
    "ServiceUser"
  ],
  "settings": {
