{
  "name": "salesforce-app",
  "private": true,
  "version": "1.0.0",
  "description": "Salesforce App",
  "scripts": {
    "lint": "eslint \"force-app/main/default/lwc/**/*.js\" --no-error-on-unmatched-pattern",
    "test": "npm run test:unit",
    "test:unit": "echo 'echo' && sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "test:apex": "sf apex run test --class-names AgentAssistConfigControllerTest --code-coverage --result-format human --wait 10",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "echo 'ho ho ho' || lint-staged",
    "devhub:login": "sf org login web --alias DevHub --set-default-dev-hub",
    "prod:login": "sf org login web --alias prod --instance-url https://login.salesforce.com --set-default",
    "scratch:create": "sf org create scratch --alias scratch --edition developer --target-dev-hub DevHub --definition-file config/project-scratch-def.json --set-default && npm run deploy && npm run assign && npm run open",
    "scratch:delete": "sf org delete scratch --target-org scratch --no-prompt",
    "predeploy": "node scripts/predeployment-tasks.js",
    "deploy": "sf project deploy start --source-dir force-app --ignore-conflicts",
    "assign": "sf apex run --file scripts/apex/assignPermsets.apex | grep 'USER_DEBUG' | sed 's/.*|DEBUG|/[Apex Log] /' || true",
    "open": "sf org open",
    "generate-aa-static-resources": "./generate-aa-static-resources.sh",
    "install-five9-package": "sf package install --package 04tTN000000C1rZYAS --security-type AllUsers --wait 30",
    "install-twilioflex-package": "sf package install --package 04t8Z0000012JNXQA2 --security-type AllUsers --wait 30",
    "install-nice-package": "sf package install --package 04tUi000000L76XIAS --security-type AllUsers --wait 30",
    "install-genesys-package": "sf package install --package 04tQp000000ngyzIAA --security-type AllUsers --wait 30"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.5",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
