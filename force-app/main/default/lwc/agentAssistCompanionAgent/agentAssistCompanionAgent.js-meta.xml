    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Google Cloud Agent Assist Companion Agent</masterLabel>
    <description
  >Interactive AI Companion Agent for Record Pages, Utility Bar, and App Pages</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__UtilityBar</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig
      targets="lightning__RecordPage,lightning__UtilityBar,lightning__AppPage"
    >
            <property
        name="configName"
        type="String"
        label="LWC Configuration Profile Name"
        datasource="apex://AgentAssistCompanionPicklist"
        default="Default_Companion"
        description="Select a Companion Agent LWC configuration profile managed in the Setup Wizard."
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
